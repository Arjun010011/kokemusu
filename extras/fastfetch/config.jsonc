// Kokemusu for fastfetch: a paper swan on dark water, moss ripples spreading from
// it and a broken stone reflection below, beside the system grouped into small
// trees with moss headings and a row of palette swatches.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/kokemusu-logo.txt",
    "color": {
      "1": "38;2;127;166;110",
      "2": "38;2;207;205;196",
      "3": "38;2;98;99;94"
    },
    "padding": { "top": 0, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "38;2;124;125;119",
      "title": "38;2;224;222;213",
      "output": "38;2;207;205;196",
      "separator": "38;2;74;75;71"
    },
    "bar": {
      "char": { "elapsed": "■", "total": "·" },
      "color": { "elapsed": "38;2;127;166;110", "total": "38;2;74;75;71" },
      "border": null,
      "width": 8
    },
    "percent": { "type": ["bar", "num"], "color": { "green": "38;2;127;166;110", "yellow": "38;2;214;189;138", "red": "38;2;201;131;120" } }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": { "user": "38;2;224;222;213", "at": "38;2;74;75;71", "host": "38;2;127;166;110" }
    },
    { "type": "custom", "format": "\u001b[38;2;98;99;94m苔むす  a swan on still water" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;127;166;110m╭ \u001b[38;2;207;205;196msystem" },
    { "type": "os", "key": "│ os       ", "keyColor": "38;2;74;75;71", "format": "{pretty-name}" },
    { "type": "kernel", "key": "│ kernel   ", "keyColor": "38;2;74;75;71", "format": "{release}" },
    { "type": "wm", "key": "│ wm       ", "keyColor": "38;2;74;75;71", "format": "{pretty-name}" },
    { "type": "shell", "key": "│ shell    ", "keyColor": "38;2;74;75;71", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "│ terminal ", "keyColor": "38;2;74;75;71", "format": "{pretty-name}" },
    { "type": "packages", "key": "╰ packages ", "keyColor": "38;2;74;75;71", "format": "{all}" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;127;166;110m╭ \u001b[38;2;207;205;196mhardware" },
    { "type": "cpu", "key": "│ cpu      ", "keyColor": "38;2;74;75;71", "format": "{cores-physical} cores, {cores-logical} threads" },
    { "type": "gpu", "key": "│ gpu      ", "keyColor": "38;2;74;75;71", "format": "{name}" },
    { "type": "memory", "key": "│ memory   ", "keyColor": "38;2;74;75;71", "format": "{percentage-bar} {used} / {total}" },
    { "type": "disk", "key": "│ disk     ", "keyColor": "38;2;74;75;71", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total}" },
    { "type": "battery", "key": "╰ battery  ", "keyColor": "38;2;74;75;71", "format": "{capacity-bar} {capacity}" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;127;166;110m╭ \u001b[38;2;207;205;196mtoday" },
    { "type": "uptime", "key": "│ awake    ", "keyColor": "38;2;74;75;71" },
    { "type": "datetime", "key": "╰ now      ", "keyColor": "38;2;74;75;71", "format": "{weekday} {day-in-month} {month-name-short}, {hour-pretty}:{minute-pretty}" },
    "break",
    {
      "type": "custom",
      "format": "   \u001b[38;2;201;131;120m███\u001b[38;2;212;161;133m███\u001b[38;2;214;189;138m███\u001b[38;2;127;166;110m███\u001b[38;2;136;174;167m███\u001b[38;2;134;159;174m███\u001b[38;2;167;152;176m███\u001b[38;2;207;205;196m███"
    }
  ]
}
