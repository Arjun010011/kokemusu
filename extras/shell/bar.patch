--- Bar.qml
+++ Bar.qml
@@ -1268,6 +1268,19 @@
     WlrLayershell.namespace: "omarchy-bar"
     WlrLayershell.layer: WlrLayer.Top
 
+    // Kokemusu: one flat full-width strip. A grey hairline on the edge facing
+    // the desktop turns faintly moss while the pointer is on the bar.
+    Rectangle {
+      visible: !root.transparent
+      z: 1
+      x: root.vertical ? (root.position === "left" ? parent.width - 1 : 0) : 0
+      y: root.vertical ? 0 : (root.position === "bottom" ? 0 : parent.height - 1)
+      width: root.vertical ? 1 : parent.width
+      height: root.vertical ? parent.height : 1
+      color: root.barHovered ? Util.alpha(Color.accent, 0.45) : Util.alpha(Color.foreground, 0.1)
+      Behavior on color { ColorAnimation { duration: 320; easing.type: Easing.OutCubic } }
+    }
+
     Loader {
       anchors.fill: parent
       sourceComponent: root.vertical ? verticalBar : horizontalBar
