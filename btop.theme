# Kokemusu for btop: grey boxes, one solid colour per meter.
# btop fades every meter from *_start through *_mid to *_end. All three are the
# same colour here, so each meter stays flat.

theme[main_bg]="#161716"
theme[main_fg]="#cfcdc4"
theme[title]="#b5b3aa"
theme[hi_fg]="#7fa66e"
theme[selected_bg]="#2d3a2f"
theme[selected_fg]="#e0ded5"
theme[inactive_fg]="#4a4b47"
theme[graph_text]="#7c7d77"
theme[meter_bg]="#2a2b29"
theme[proc_misc]="#869fae"

theme[cpu_box]="#3a3b38"
theme[mem_box]="#3a3b38"
theme[net_box]="#3a3b38"
theme[proc_box]="#3a3b38"
theme[div_line]="#2a2b29"

theme[temp_start]="#d4a185"
theme[temp_mid]="#d4a185"
theme[temp_end]="#d4a185"

theme[cpu_start]="#7fa66e"
theme[cpu_mid]="#7fa66e"
theme[cpu_end]="#7fa66e"

theme[free_start]="#7fa66e"
theme[free_mid]="#7fa66e"
theme[free_end]="#7fa66e"

theme[cached_start]="#869fae"
theme[cached_mid]="#869fae"
theme[cached_end]="#869fae"

theme[available_start]="#7fa66e"
theme[available_mid]="#7fa66e"
theme[available_end]="#7fa66e"

theme[used_start]="#88aea7"
theme[used_mid]="#88aea7"
theme[used_end]="#88aea7"

theme[download_start]="#869fae"
theme[download_mid]="#869fae"
theme[download_end]="#869fae"

theme[upload_start]="#d4a185"
theme[upload_mid]="#d4a185"
theme[upload_end]="#d4a185"

theme[process_start]="#7fa66e"
theme[process_mid]="#7fa66e"
theme[process_end]="#7fa66e"
